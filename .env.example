# RAG Glass Box: answer generation with free LLM tiers. Copy to .env.local (gitignored) for local dev,
# and set the same variables in Vercel → Project → Settings → Environment Variables for production.

# Providers to try, in order. Each one is skipped if its key is missing.
LLM_PROVIDERS=groq,gemini

# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the models tried on Groq (each has its own free daily quota).
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-lite-latest

# Local development only (Ollama does not run on Vercel): LLM_PROVIDERS=ollama
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Skip a provider that has not started streaming after this long (default 4000 ms).
# LLM_FIRST_TOKEN_TIMEOUT_MS=4000
