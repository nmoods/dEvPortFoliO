{
  "name": "@nmoods/basecamp-ui",
  "version": "0.1.0",
  "description": "Accessible, token-driven React components: Button, Tabs, Dialog and Combobox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "module": "./dist/basecamp-ui.js",
  "exports": {
    ".": "./dist/basecamp-ui.js",
    "./styles.css": "./dist/basecamp-ui.css"
  },
  "scripts": {
